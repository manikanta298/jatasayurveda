# Copy this file to .env and fill in real values before running the server.
# Never commit the actual .env file.

# --- Core ---
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/jata-ayurveda
CLIENT_URL=http://localhost:5173

# --- Staff/admin auth (backend/models/User.js) ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=jata_token
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# --- Customer accounts (backend/models/Customer.js) ---
# Uses the same JWT_SECRET above, but a separate cookie so staff and
# customer sessions never collide.
CUSTOMER_JWT_COOKIE_NAME=jata_customer_token

# Google sign-in for customers: create an OAuth 2.0 Client ID (Web
# application) at https://console.cloud.google.com/apis/credentials, add
# your site's URL under "Authorized JavaScript origins", then set this to
# the Client ID. The frontend needs the SAME value in its own env as
# VITE_GOOGLE_CLIENT_ID. Leave blank to disable Google sign-in — customers
# will just see email/password options.
GOOGLE_CLIENT_ID=

# Contact form → Google Sheet (backend/controllers/contact.controller.js).
# The Apps Script /exec URL from your Contact Form Google Sheet's
# Extensions → Apps Script → Deploy → Web app. This now runs server-side —
# calling it directly from the browser hits CORS errors since Apps Script
# doesn't send the headers a cross-origin browser fetch requires. Leave
# blank to just save contact messages to the database without also
# forwarding them to a Sheet.
GOOGLE_SCRIPT_URL=

# Email OTP for customer registration/password reset
# (backend/services/email, backend/models/OtpCode.js). Gmail SMTP — requires
# a Google Account App Password (NOT your normal Gmail password):
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate an app password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password below (remove spaces)
#
# Known issue: if deployed on Render, Gmail SMTP has previously failed with
# a consistent ~15s ETIMEDOUT — Render restricts outbound SMTP on many
# plans. Works reliably for local dev. Leave blank and codes are just
# logged to the server console instead of emailed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=JATA Ayurveda
# Book Consultation recipient email
CONSULTATION_RECIPIENT_EMAIL=
OTP_TTL_MINUTES=10

# --- Cloudinary (media uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payment gateways (backend/services/payments) ---
# Each gateway is only offered at checkout once its keys below are set —
# leaving one blank simply hides it, it never breaks the server.

# Razorpay (Cards, UPI, Netbanking, Wallets): https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ICICI Bank payment gateway: values come from ICICI's merchant
# onboarding/integration kit once you sign up with them.
ICICI_MERCHANT_ID=
ICICI_SECRET_KEY=
ICICI_GATEWAY_URL=https://eazypay.icicibank.com/EazyPG

# Cash on Delivery has no keys — it's always available.
