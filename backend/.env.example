# Copy this file to .env and fill in real values before running the server.
# Never commit the actual .env file.

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/jata-ayurveda
CLIENT_URL=http://localhost:5173

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=jata_token
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
CUSTOMER_JWT_COOKIE_NAME=jata_customer_token

GOOGLE_CLIENT_ID=
GOOGLE_SCRIPT_URL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=JATA Ayurveda
CONSULTATION_RECIPIENT_EMAIL=
OTP_TTL_MINUTES=10

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payment gateways ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- ICICI Bank Payment Gateway / UAT ---
# Values below come from the supplied ICICI UAT integration document.
ICICI_ENV=uat
ICICI_MERCHANT_ID=100000000007164
ICICI_AGGREGATOR_ID=A100000000007164
# UAT secret key: set this only in the deployment/server secret store.
# Do NOT commit the key from the PDF to Git.
ICICI_SECRET_KEY=
# APPID is supplied by ICICI but is not required by the documented Sale/Status calls.
ICICI_APP_ID=80bc18249511f868

# ICICI posts the browser payment result to this HTTPS backend endpoint.
ICICI_RETURN_URL=https://YOUR-BACKEND-HOST/api/v1/orders/icici/return
# Existing checkout posts to this bridge, which then redirects to ICICI's redirectURI?tranCtx=...
ICICI_START_URL=https://YOUR-BACKEND-HOST/api/v1/orders/icici/start
# Optional alias for ICICI_START_URL. Leave blank when ICICI_START_URL is set.
ICICI_REDIRECT_BRIDGE_URL=
ICICI_FRONTEND_URL=https://jatasayurveda.com
# Configure this URL with ICICI for server-to-server Payment Advice.
ICICI_ADVICE_URL=https://YOUR-BACKEND-HOST/api/v1/orders/icici/advice

# Leave these blank to use the documented UAT/production endpoints.
ICICI_SALE_URL=
ICICI_COMMAND_URL=
# Optional payment-mode restriction: CARD, NB, WALLET or UPI.
ICICI_PAYMENT_MODE=
ICICI_TXN_CHANNEL=WEB
# Optional merchant-configured UDF slots.
ICICI_UDF23=
ICICI_UDF24=
