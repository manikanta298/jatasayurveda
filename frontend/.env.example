# Copy this file to .env and fill in real values before running the dev server or building.

# Backend API base URL (must match where the backend is deployed)
VITE_API_URL=http://localhost:5000/api/v1

# Google sign-in for customers (Continue with Google button). Must be the
# SAME Client ID as the backend's GOOGLE_CLIENT_ID (backend/.env.example).
# Leave blank to hide the "Continue with Google" button — email OTP
# registration and login still work.
VITE_GOOGLE_CLIENT_ID=
